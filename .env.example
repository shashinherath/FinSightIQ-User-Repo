# ==============================================================================
# FinSightIQ User Service — Local Environment Configuration
# ==============================================================================
# Copy this file to '.env' for local container or environment configuration:
#   cp .env.example .env
#
# DO NOT commit '.env' or real secrets to source control.
# ==============================================================================

# ASP.NET Core Runtime Mode
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5101

# PostgreSQL Database Connection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=finsightiq_users;Username=postgres;Password=postgres

# Security & JWT Authentication (RS256 Private Key)
# In Development mode, an ephemeral RSA key is generated automatically if empty.
# In Staging and Production, a valid PEM string or path to private key file is required.
Jwt__Issuer=finsightiq
Jwt__Audience=finsightiq
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=7
Jwt__PrivateKeyPem=
