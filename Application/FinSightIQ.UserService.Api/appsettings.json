{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UserDb": "Host=localhost;Port=5432;Database=usersdb;Username=postgres;Password=postgres_dev_password"
  },
  "Jwt": {
    "Issuer": "finsightiq",
    "Audience": "finsightiq",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "KeyId": "finsightiq-key",
    "PrivateKeyPem": "",
    "PublicKeyPem": ""
  },
  "Cookie": {
    "Name": "refreshToken",
    "Secure": false,
    "SameSite": "Strict"
  }
}
